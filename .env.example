# ==============================================================================
# BUYWISE AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Public Application URL (Used for SEO canonical URLs, sitemaps, and OpenGraph)
NEXT_PUBLIC_APP_URL=https://buywise.ai

# AI Advisor Service (Optional / Server-Side only)
# Leave blank or unconfigured to use local heuristic & NLP recommendation engine
OPENAI_API_KEY=

# eBay Browse API (Server-Side only — Developer Account Pending Approval)
# Used by eBay adapter once developer access is activated
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=PRODUCTION
